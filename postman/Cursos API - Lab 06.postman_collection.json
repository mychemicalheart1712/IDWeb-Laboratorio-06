          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status es success\", () => pm.expect(pm.response.json().status).to.eql(\"success\"));",
                  "pm.test(\"data es un arreglo\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}",
              "host": [
                "{{base}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 GET filtrado por creditos",
