    {
      "name": "2. Escrituras",
      "item": [
        {
          "name": "2.1 POST curso valido (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devuelve el curso creado\", () => {",
                  "  const curso = pm.response.json().data;",
                  "  pm.expect(curso.nombre).to.eql(\"Base de Datos I\");",
                  "  pm.expect(curso.codigo).to.eql(\"BD101\");",
                  "});",
                  "pm.test(\"Se genero un id\", () => pm.expect(pm.response.json().data.id).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"cursoId\", pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"nombre\": \"Base de Datos I\", \"codigo\": \"BD101\", \"creditos\": 4 }"
            },
            "url": {
              "raw": "{{base}}",
              "host": [
