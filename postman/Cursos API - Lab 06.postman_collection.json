            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Todos tienen 4 creditos\", () => {",
                  "  pm.response.json().data.forEach(c => pm.expect(c.creditos).to.eql(4));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}?creditos=4",
              "host": [
                "{{base}}"
              ],
              "query": [
                {
                  "key": "creditos",
                  "value": "4"
                }
              ]
            }
          },
          "response": []
        },
